rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*@andamanquiz\\.com$') ||
        request.auth.token.email.matches('.*@andamanquiz[.]com')
      );
    }

    // Public read for question images and banners; Admin upload
    match /question_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
