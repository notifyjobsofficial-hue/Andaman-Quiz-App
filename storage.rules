rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Public read for question images and banners; Admin upload
    match /question_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PDF uploads for AI Question Import: Admin only read/write
    match /admin_pdf_uploads/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
