rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'Admin']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true
      );
    }

    // 1. Categories: Public read for students, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Exams: Public read for students, Admin write
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Subjects: Public read for students, Admin write
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Topics: Public read for students, Admin write
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Questions Bank: Public read for student exam runner, Admin write
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Mock Tests: Public read for students, Admin write
    match /mock_tests/{mockId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mocks/{mockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Live Tests & Registrations
    // NOTE & SECURITY DISCLOSURE:
    // The student app is unauthenticated / login-free.
    // The installation UUID is a pseudonymous client identifier, NOT a verified identity
    // and cannot provide cryptographic ownership or authentication.
    match /live_tests/{liveTestId} {
      allow read: if true;
      allow write: if isAdmin();

      match /registrations/{regId} {
        // Privacy: Only Admin can read all registrations (protects participant list from public scraping)
        allow read: if isAdmin();

        // Create: Unauthenticated student registration with strict schema validation
        allow create: if request.resource.data.liveTestId == liveTestId
          && request.resource.data.testId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 100
          && request.resource.data.installationId is string
          && request.resource.data.installationId.size() > 0
          && request.resource.data.installationId.size() <= 100
          && request.resource.data.registeredAt is timestamp
          && request.resource.data.paymentType in ['FREE', 'PAID']
          && request.resource.data.status == 'REGISTERED'
          && request.resource.data.keys().hasOnly([
            'id', 'liveTestId', 'testId', 'studentName', 'mobile',
            'installationId', 'registeredAt', 'paymentType',
            'entitlementStatus', 'status'
          ]);

        // Update: Status transitions (REGISTERED -> STARTED -> SUBMITTED)
        allow update: if isAdmin() || (
          // Status transition to STARTED
          (request.resource.data.status == 'STARTED'
            && resource.data.status == 'REGISTERED'
            && request.resource.data.startedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt']))
          ||
          // Status transition to SUBMITTED
          (request.resource.data.status == 'SUBMITTED'
            && (resource.data.status == 'STARTED' || resource.data.status == 'REGISTERED')
            && request.resource.data.submittedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'score']))
        );

        allow delete: if isAdmin();
      }
    }

    // 8. Question of the Day (QOTD): Public read, Admin write
    match /qotd/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Home Banners & Notices: Public read, Admin write
    match /app_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. App Config & Maintenance Mode: Public read, Admin write
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. PDF AI Import Jobs & Staging Queue: Admin only read/write
    match /pdf_import_jobs/{jobId} {
      allow read, write: if isAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isAdmin();
      }
    }

    // 12. Admin Activity Logs: Admin only read/write
    match /admin_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    // 12. Student Purchases / Entitlements: Public create, Admin manage
    match /purchases/{purchaseId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 13. Student Test Attempts: Public create, Admin read/write
    match /test_attempts/{attemptId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 14. Practice Topic Stats & Sessions (Atomic session counter & audit)
    // NOTE & SECURITY DISCLOSURE:
    // Because student app usage is completely login-free and unauthenticated,
    // Firestore rules constrain the payload invariants (only allowing +1 increments coupled with
    // immutable session document creation) but cannot cryptographically prove human identity
    // or prevent fabricated requests without a verified authentication/attestation layer.
    match /practice_topic_stats/{topicId} {
      allow read: if true;

      // Allow create only if initial totalSessions is 1 and created atomically with its session doc
      allow create: if request.resource.data.topicId == topicId
        && request.resource.data.totalSessions == 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastSessionId is string
        && request.resource.data.lastSessionId.size() > 0
        && request.resource.data.lastSessionId.size() < 100
        && request.resource.data.keys().hasOnly(['topicId', 'totalSessions', 'updatedAt', 'lastSessionId'])
        && !exists(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId))
        && existsAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId))
        && getAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId)).data.sessionId == request.resource.data.lastSessionId
        && getAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId)).data.topicId == topicId;

      // Allow update only if totalSessions increments by exactly 1 and coupled with new session doc
      allow update: if isAdmin() || (
        request.resource.data.topicId == topicId
        && request.resource.data.totalSessions == resource.data.totalSessions + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastSessionId is string
        && request.resource.data.lastSessionId.size() > 0
        && request.resource.data.lastSessionId.size() < 100
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalSessions', 'updatedAt', 'lastSessionId'])
        && !exists(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId))
        && existsAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId))
        && getAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId)).data.sessionId == request.resource.data.lastSessionId
        && getAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)/sessions/$(request.resource.data.lastSessionId)).data.topicId == topicId
      );

      allow delete: if isAdmin();

      // Session event subcollection (immutable audit / deduplication)
      match /sessions/{sessionId} {
        // PRIVACY HARDENING: Student app does not read individual session audits or installation UUIDs
        allow read: if isAdmin();

        // Create only once per unique sessionId; strictly validate fields and couple with parent counter write
        allow create: if request.resource.data.sessionId == sessionId
          && request.resource.data.sessionId.size() > 0
          && request.resource.data.sessionId.size() < 100
          && request.resource.data.topicId == topicId
          && request.resource.data.installationId is string
          && request.resource.data.installationId.size() > 0
          && request.resource.data.installationId.size() < 100
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly(['sessionId', 'topicId', 'installationId', 'createdAt'])
          && existsAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId))
          && getAfter(/databases/$(database)/documents/practice_topic_stats/$(topicId)).data.lastSessionId == sessionId;

        allow update, delete: if isAdmin();
      }
    }

    // 15. Admins collection:
    // Any authenticated user can read their own admin document (admins/{uid}) to verify role on login.
    // Full roster listing and all admin modifications are strictly restricted to verified administrators.
    match /admins/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 16. Test Series, Folders & Items: Public read for students, Admin write
    match /test_series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();

      match /folders/{folderId} {
        allow read: if true;
        allow write: if isAdmin();

        match /items/{itemId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // 17. Study Library: Public read, Admin write
    // SECURITY CONSTRAINT: No public client-writable viewCount or counters. Writes strictly restricted to Admin.
    match /study_folders/{folderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /study_materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 18. Battle / Competition Mode & Registrations
    // NOTE & SECURITY DISCLOSURE:
    // Student app usage is login-free. The installation UUID is a pseudonymous client identifier.
    // In accordance with Architectural Correction 8, battle rank is NEVER client-written;
    // rank is computed on the server/admin/leaderboard.
    match /battles/{battleId} {
      allow read: if true;
      allow write: if isAdmin();

      match /registrations/{regId} {
        // Privacy: Only Admin can read all registrations (protects participant list from public scraping)
        allow read: if isAdmin();

        // Create: Unauthenticated student registration with strict schema validation
        allow create: if request.resource.data.battleId == battleId
          && request.resource.data.testId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 100
          && request.resource.data.installationId is string
          && request.resource.data.installationId.size() > 0
          && request.resource.data.installationId.size() <= 100
          && request.resource.data.registeredAt is timestamp
          && request.resource.data.status == 'REGISTERED'
          && request.resource.data.keys().hasOnly([
            'id', 'battleId', 'testId', 'studentName', 'mobile',
            'installationId', 'registeredAt', 'status'
          ]);

        // Update: Status transitions (REGISTERED -> LOBBY/STARTED -> SUBMITTED)
        // Strictly prevents client tampering with other registrations, and forbids rank write.
        allow update: if isAdmin() || (
          // Transition to LOBBY or STARTED
          ((request.resource.data.status == 'LOBBY' || request.resource.data.status == 'STARTED')
            && (resource.data.status == 'REGISTERED' || resource.data.status == 'LOBBY')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt']))
          ||
          // Transition to SUBMITTED
          (request.resource.data.status == 'SUBMITTED'
            && (resource.data.status == 'STARTED' || resource.data.status == 'LOBBY' || resource.data.status == 'REGISTERED')
            && request.resource.data.submittedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'score', 'accuracy', 'timeTakenSeconds']))
        );

        allow delete: if isAdmin();
      }
    }

    // 19. Question Reports: Student submit, Admin read & moderate
    // NOTE & LIMITATION: Unauthenticated reporting cannot enforce cryptographic per-user rate limits
    // in Firestore security rules. Rules enforce strict schema validation; client enforces cooldown;
    // admin dashboard provides bulk moderation and deduplication.
    match /question_reports/{reportId} {
      allow read: if isAdmin();

      allow create: if request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.issueType in [
          'INCORRECT_QUESTION', 'WRONG_ANSWER', 'FORMATTING_ISSUE',
          'IMAGE_ISSUE', 'EXPLANATION_ISSUE', 'OTHER'
        ]
        && request.resource.data.installationId is string
        && request.resource.data.installationId.size() > 0
        && request.resource.data.installationId.size() <= 100
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'id', 'questionId', 'testId', 'topicId', 'issueType',
          'details', 'installationId', 'status', 'createdAt'
        ]);

      allow update, delete: if isAdmin();
    }

    // 20. Career Goals & Roadmap: Public read, Admin write
    match /career_goals/{goalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 21. Current Affairs: Public read, Admin write
    match /current_affairs/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 22. App Home Dynamic Sections: Public read, Admin write
    match /app_home_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

