rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'Admin']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true
      );
    }

    // 1. Categories: Public read for students, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Exams: Public read for students, Admin write
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Subjects: Public read for students, Admin write
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Topics: Public read for students, Admin write
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Questions Bank: Public read for student exam runner, Admin write
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Mock Tests: Public read for students, Admin write
    match /mock_tests/{mockId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mocks/{mockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Live Tests: Public read for students, Admin write
    match /live_tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Question of the Day (QOTD): Public read, Admin write
    match /qotd/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Home Banners & Notices: Public read, Admin write
    match /app_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. App Config & Maintenance Mode: Public read, Admin write
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. PDF AI Import Jobs & Staging Queue: Admin only read/write
    match /pdf_import_jobs/{jobId} {
      allow read, write: if isAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isAdmin();
      }
    }

    // 12. Admin Activity Logs: Admin only read/write
    match /admin_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    // 12. Student Purchases / Entitlements: Public create, Admin manage
    match /purchases/{purchaseId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 13. Student Test Attempts: Public create, Admin read/write
    match /test_attempts/{attemptId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 14. Admins collection:
    // Any authenticated user can read their own admin document (admins/{uid}) to verify role on login.
    // Full roster listing and all admin modifications are strictly restricted to verified administrators.
    match /admins/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
